load("lib/math/index.lox");
load("lib/stdlib/index.lox");

print(modulo(14,3));    // 2
print(modulo(14,-3));   // 2
print(modulo(-14,-3));  // -2
print(modulo(-14,3));   // -2

print(power(3,3));      // 27
print(power(3,-3));     // 0.037037..
print(power(-3,-3));    // -0.037037..
print(power(-3,3));     // -27

print(slice([1,2,3,4,5], -5, -4));   // [1]
print(slice([1,2,3,4,5], -5, 2));    // [1, 2]
print(slice([1,2,3,4,5], -5, -6));   // []
print(slice([1,2,3,4,5], 1, 3));     // [2, 3]
print(slice([1,2,3,4,5], -3, 4));    // [3, 4]

print(slice("hello", -5, -4));   // "h"
print(slice("hello", -5, 2));    // "he"
print(slice("hello", -5, -6));   // ""
print(slice("hello", 1, 3));     // "el"
print(slice("hello", -3, 4));    // "ll"
