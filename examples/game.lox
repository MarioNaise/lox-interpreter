fun start(){

  load("greet.lox");

  print("Are you ready to play a game?");
  var answer = read();
  if(answer == "yes"){
    print("Great! Let's play a game!");
    firstGame();
  } else {
    print("Oh, that's too bad. Maybe next time.");
  }
}

fun firstGame(){
  print("I'm thinking of a number between 1 and 10. Can you guess what it is?");
  var answer;
  var correct = string(random(10) + 1);
  fun quiz(){
    answer = read();
    if(answer == correct){
      print(correct + " is correct! You win!");
    } else {
      print("Sorry, that's not it. Try again.");
      return quiz();
    }
  }
  quiz();
  print("Would you like to play something else?");
  answer = read();
  if(answer == "yes"){
    secondGame();
  } else {
    print("Thanks for playing!");
  }
}

fun secondGame(){
  print("Not implemented!");
}

start();
